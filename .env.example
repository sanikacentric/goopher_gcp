# Copy to .env for local development.  NEVER commit a real .env.
# This template is committed; keep it free of real secrets.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- LLM provider (ACTIVE: OpenAI for all conversations) ---
# Get a key: https://platform.openai.com/api-keys
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # optional (Azure/proxy); leave blank for default

# --- Gemini / Google ADK.  Set LLM_PROVIDER=gemini + USE_ADK_PATH=true to use
#     the ADK multi-agent orchestrator (emits ADK traces).
GEMINI_MODEL=gemini-2.5-flash
USE_ADK_PATH=false
# Auth option 1 — AI Studio API key (free tier = only 20 req/day):
#   https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# Auth option 2 — Vertex AI (recommended; uses $300 GCP credit / high quota).
#   Set USE_VERTEXAI=true, then: gcloud auth application-default login
USE_VERTEXAI=false
VERTEX_LOCATION=us-central1

# --- Database backend: "sqlite" (local) or "firestore" (GCP free tier) ---
DB_BACKEND=sqlite
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# --- Access control (single-user lockdown) ---
# Comma-separated allowlist of emails permitted to log in / use the endpoint.
ALLOWED_EMAILS=demo@goopher.app
# Master password for the allowed account(s). Set a strong secret via env /
# Secret Manager. Login is REJECTED for everyone if this is left unset.
MASTER_PASSWORD=

# --- Observability ---
ENABLE_TRACING=true
OTEL_EXPORTER=console   # or "gcp" for Cloud Trace on Cloud Run

# --- Order-confirmation email (optional) ---
# Every placed order emails a confirmation to NOTIFY_EMAIL. With NO transport set
# below it runs in SIMULATED mode (logged + shown in the reply). To send for real,
# set ONE transport (SMTP or Resend). Never commit real secrets.
NOTIFY_EMAIL=your-address@example.com
EMAIL_FROM=GOOPHER <orders@goopher.app>
# Option A — SMTP (e.g. Gmail with an App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# Option B — Resend (free tier, https://resend.com):
# RESEND_API_KEY=re_xxx
