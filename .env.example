# Copy to .env for local development.  NEVER commit a real .env.
# This template is committed; keep it free of real secrets.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Gemini (free tier).  Get a key: https://aistudio.google.com/app/apikey ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Database backend: "sqlite" (local) or "firestore" (GCP free tier) ---
DB_BACKEND=sqlite
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# --- Observability ---
ENABLE_TRACING=true
OTEL_EXPORTER=console   # or "gcp" for Cloud Trace on Cloud Run
