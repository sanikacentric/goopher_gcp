{
  "manifest_version": 3,
  "name": "GOOPHER",
  "version": "0.5.1",
  "description": "GOOPHER — a unified conversational shopping agent for clothing, food & toys. Inventory, orders (with cart + staged checkout), multi-channel, multi-lingual, multi-modal (incl. voice).",
  "permissions": ["storage", "sidePanel", "activeTab"],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open GOOPHER",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
